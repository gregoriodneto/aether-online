// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Characters {
  id             Uuid                                 @id(map: "characters_pkey")
  serverId       Uuid                                 @map("server_id")
  name           String(storage: varchar, length: 50)
  characterClass String(storage: varchar, length: 30) @map("character_class")
  level          Int                                  @default(1)
  version        BigInt                               @default(0)
  createdAt      DateTime(precision: 6)               @default(now()) @map("created_at")

  @@index(expression: sql`server_id, lower(name::text)`, map: "uk_character_server_name", unique: true)
  @@check(expression: sql`(level >= 1)`, map: "chk_character_level")
  @@check(expression: sql`((length(TRIM(BOTH FROM name)) >= 3) AND (length(TRIM(BOTH FROM name)) <= 50))`, map: "chk_character_name")
  @@map("characters")
}

model FlywaySchemaHistory {
  installedRank Int                                        @id(map: "flyway_schema_history_pk") @map("installed_rank")
  version       String(storage: varchar, length: 50)?
  description   String(storage: varchar, length: 200)
  _type         String(storage: varchar, length: 20)       @map("type")
  script        String(storage: varchar, length: 1000)
  checksum      Int?
  installedBy   String(storage: varchar, length: 100)      @map("installed_by")
  installedOn   DateTime(storage: timestamp, precision: 6) @default(now()) @map("installed_on")
  executionTime Int                                        @map("execution_time")
  success       Boolean

  @@index([success], map: "flyway_schema_history_s_idx")
  @@map("flyway_schema_history")
}
